// ==UserScript==
// @name         Phase Babysitter
// @namespace    https://github.com/digisurfsome/AppSitter
// @version      1.0
// @description  Auto-feeds build phases into AI chat sequentially — watches for completion and advances automatically
// @author       AppSitter
// @match        https://claude.ai/*
// @match        https://chatgpt.com/*
// @match        https://chat.openai.com/*
// @match        https://gemini.google.com/*
// @grant        none
// @run-at       document-idle
// ==/UserScript==

(function () {
  'use strict';

  // ============================================================
  // CONSTANTS
  // ============================================================

  var STORAGE = {
    phases: 'pb-phases',
    currentPhase: 'pb-current-phase',
    repoUrl: 'pb-repo-url',
    state: 'pb-state',
    panelOpen: 'pb-panel-open'
  };

  var IDLE_THRESHOLD = 5000;
  var POLL_INTERVAL = 2000;
  var POST_SEND_DELAY = 3000;
  var INTER_PHASE_DELAY = 2500;
  var SEND_RETRY_DELAY = 600;
  var SEND_MAX_RETRIES = 4;
  var PHASE_MARKER_RE = /---\s*PHASE\s+(\d+)\s*---/gi;

  // ============================================================
  // STATE
  // ============================================================

  var phases = [];
  var currentPhaseIndex = 0;
  var runnerState = 'idle';
  var lastMutationTime = 0;
  var mutationObserver = null;
  var completionPollTimer = null;
  var onCompletionCb = null;
  var panelEl = null;
  var phaseListEl = null;
  var logEl = null;
  var statusTextEl = null;
  var phaseCountEl = null;
  var startBtn = null;
  var pauseBtn = null;
  var stopBtn = null;
  var skipBtn = null;
  var toggleBtn = null;

  // ============================================================
  // SITE DETECTION
  // ============================================================

  function detectSite() {
    var host = window.location.hostname;
    if (host.indexOf('claude.ai') !== -1) return 'claude';
    if (host.indexOf('chatgpt.com') !== -1 || host.indexOf('chat.openai.com') !== -1) return 'chatgpt';
    if (host.indexOf('gemini.google.com') !== -1) return 'gemini';
    return 'unknown';
  }

  var SITE = detectSite();

  // ============================================================
  // CHAT INPUT DETECTION & INJECTION
  // ============================================================

  function getEditor() {
    var el;
    el = document.querySelector('.ProseMirror[contenteditable="true"]');
    if (el) return { el: el, type: 'prosemirror' };
    el = document.querySelector('div[data-placeholder][contenteditable="true"]');
    if (el) return { el: el, type: 'prosemirror' };
    el = document.querySelector('#prompt-textarea');
    if (el) return { el: el, type: 'prosemirror' };
    el = document.querySelector('.ql-editor[contenteditable="true"]');
    if (el) return { el: el, type: 'prosemirror' };
    el = document.querySelector('div[contenteditable="true"]');
    if (el) return { el: el, type: 'prosemirror' };
    el = document.querySelector('textarea');
    if (el) return { el: el, type: 'textarea' };
    return null;
  }

  function injectText(text) {
    var editor = getEditor();
    if (!editor) return false;
    var el = editor.el;
    var type = editor.type;

    if (type === 'textarea') {
      var setter = Object.getOwnPropertyDescriptor(
        window.HTMLTextAreaElement.prototype, 'value'
      ).set;
      setter.call(el, text);
      el.dispatchEvent(new Event('input', { bubbles: true }));
      el.focus();
      return true;
    }

    el.focus();
    var sel = window.getSelection();
    var range = document.createRange();
    range.selectNodeContents(el);
    sel.removeAllRanges();
    sel.addRange(range);
    var ok = document.execCommand('insertText', false, text);
    if (!ok) {
      var cd = new DataTransfer();
      cd.setData('text/plain', text);
      el.dispatchEvent(new ClipboardEvent('paste', {
        clipboardData: cd, bubbles: true, cancelable: true
      }));
    }
    return true;
  }

  // ============================================================
  // SEND BUTTON DETECTION & CLICKING
  // ============================================================

  var SEND_SELECTORS = {
    claude: [
      'button[aria-label="Send Message"]',
      'button[aria-label="Send message"]',
      'button[aria-label="Send"]',
      'button[data-testid="send-button"]'
    ],
    chatgpt: [
      'button[data-testid="send-button"]',
      'button[aria-label="Send prompt"]',
      'button[aria-label="Send"]'
    ],
    gemini: [
      'button[aria-label="Send message"]',
      'button.send-button',
      '.send-button-container button'
    ]
  };

  var STOP_SELECTORS = {
    claude: [
      'button[aria-label="Stop Response"]',
      'button[aria-label="Stop response"]',
      'button[aria-label="Stop"]'
    ],
    chatgpt: [
      'button[aria-label="Stop generating"]',
      'button[data-testid="stop-button"]',
      'button[aria-label="Stop"]'
    ],
    gemini: [
      'button[aria-label="Stop"]'
    ]
  };

  function findButtonFromMap(selectorMap) {
    var primary = selectorMap[SITE] || [];
    var all = primary.slice();
    var keys = Object.keys(selectorMap);
    for (var k = 0; k < keys.length; k++) {
      if (keys[k] !== SITE) {
        var extras = selectorMap[keys[k]];
        for (var j = 0; j < extras.length; j++) all.push(extras[j]);
      }
    }
    for (var i = 0; i < all.length; i++) {
      var btn = document.querySelector(all[i]);
      if (btn) return btn;
    }
    return null;
  }

  function isSendAvailable() {
    var btn = findButtonFromMap(SEND_SELECTORS);
    return btn && !btn.disabled;
  }

  function isStopVisible() {
    return !!findButtonFromMap(STOP_SELECTORS);
  }

  function attemptSend(retries, callback) {
    var btn = findButtonFromMap(SEND_SELECTORS);
    if (btn && !btn.disabled) {
      btn.click();
      if (callback) callback(true);
      return;
    }
    // Fallback: Enter key
    var editor = getEditor();
    if (editor) {
      editor.el.dispatchEvent(new KeyboardEvent('keydown', {
        key: 'Enter', code: 'Enter', keyCode: 13, which: 13,
        bubbles: true, cancelable: true
      }));
      if (callback) callback(true);
      return;
    }
    if (retries > 0) {
      setTimeout(function () {
        attemptSend(retries - 1, callback);
      }, SEND_RETRY_DELAY);
    } else {
      if (callback) callback(false);
    }
  }

  // ============================================================
  // COMPLETION DETECTION
  // ============================================================

  function getChatContainer() {
    var selectors = [
      '[class*="conversation"]',
      '[class*="chat-messages"]',
      '[role="presentation"]',
      'main',
      '[role="main"]'
    ];
    for (var i = 0; i < selectors.length; i++) {
      var el = document.querySelector(selectors[i]);
      if (el) return el;
    }
    return document.body;
  }

  function startCompletionDetection(callback) {
    stopCompletionDetection();
    onCompletionCb = callback;
    lastMutationTime = Date.now();

    var container = getChatContainer();
    mutationObserver = new MutationObserver(function () {
      lastMutationTime = Date.now();
    });
    mutationObserver.observe(container, {
      childList: true, subtree: true, characterData: true
    });

    completionPollTimer = setInterval(function () {
      var idle = Date.now() - lastMutationTime;
      var sendOk = isSendAvailable();
      var stopUp = isStopVisible();
      if (idle >= IDLE_THRESHOLD && sendOk && !stopUp) {
        stopCompletionDetection();
        if (onCompletionCb) onCompletionCb();
      }
    }, POLL_INTERVAL);
  }

  function stopCompletionDetection() {
    if (mutationObserver) {
      mutationObserver.disconnect();
      mutationObserver = null;
    }
    if (completionPollTimer) {
      clearInterval(completionPollTimer);
      completionPollTimer = null;
    }
  }

  // ============================================================
  // PERSISTENCE
  // ============================================================

  function loadState() {
    try {
      var p = localStorage.getItem(STORAGE.phases);
      if (p) phases = JSON.parse(p);
      var c = localStorage.getItem(STORAGE.currentPhase);
      if (c !== null) currentPhaseIndex = parseInt(c, 10);
      var s = localStorage.getItem(STORAGE.state);
      if (s && s !== 'running') runnerState = s;
      if (s === 'running') runnerState = 'paused';
    } catch (_) {}
  }

  function saveState() {
    localStorage.setItem(STORAGE.phases, JSON.stringify(phases));
    localStorage.setItem(STORAGE.currentPhase, String(currentPhaseIndex));
    localStorage.setItem(STORAGE.state, runnerState);
  }

  function getRepoUrl() {
    return localStorage.getItem(STORAGE.repoUrl) || '';
  }

  function saveRepoUrl(url) {
    localStorage.setItem(STORAGE.repoUrl, url);
  }

  // ============================================================
  // PHASE PARSING & VARIABLES
  // ============================================================

  function parsePhases(rawText) {
    PHASE_MARKER_RE.lastIndex = 0;
    var markers = [];
    var match;
    while ((match = PHASE_MARKER_RE.exec(rawText)) !== null) {
      markers.push({ index: match.index, end: match.index + match[0].length, num: parseInt(match[1], 10) });
    }

    if (markers.length === 0) {
      var trimmed = rawText.trim();
      if (trimmed) return [{ number: 1, content: trimmed, status: 'pending' }];
      return [];
    }

    var result = [];
    for (var i = 0; i < markers.length; i++) {
      var start = markers[i].end;
      var end = (i + 1 < markers.length) ? markers[i + 1].index : rawText.length;
      var content = rawText.substring(start, end).trim();
      if (content) {
        result.push({ number: markers[i].num, content: content, status: 'pending' });
      }
    }
    return result;
  }

  function substituteVars(text) {
    var repoUrl = getRepoUrl();
    return text
      .replace(/\{\{REPO_URL\}\}/gi, repoUrl)
      .replace(/\{\{PHASE_NUMBER\}\}/gi, String(currentPhaseIndex + 1))
      .replace(/\{\{TOTAL_PHASES\}\}/gi, String(phases.length));
  }

  // ============================================================
  // PHASE RUNNER
  // ============================================================

  function runCurrentPhase() {
    if (currentPhaseIndex >= phases.length) {
      runnerState = 'complete';
      saveState();
      refreshUI();
      addLog('All phases complete!');
      return;
    }
    if (runnerState !== 'running') return;

    var phase = phases[currentPhaseIndex];
    phase.status = 'running';
    saveState();
    refreshUI();
    addLog('Injecting Phase ' + phase.number + '...');

    var text = substituteVars(phase.content);
    var injected = injectText(text);
    if (!injected) {
      addLog('ERROR: No chat input found. Pausing.');
      runnerState = 'paused';
      saveState();
      refreshUI();
      return;
    }

    addLog('Text injected. Attempting to send...');

    setTimeout(function () {
      if (runnerState !== 'running') return;

      attemptSend(SEND_MAX_RETRIES, function (sent) {
        if (!sent) {
          addLog('WARNING: Could not auto-send. Please click Send manually. Babysitter will still watch for completion.');
        } else {
          addLog('Phase ' + phase.number + ' sent. Watching for completion...');
        }

        setTimeout(function () {
          if (runnerState !== 'running') return;

          startCompletionDetection(function () {
            phase.status = 'complete';
            addLog('Phase ' + phase.number + ' complete!');
            currentPhaseIndex++;
            saveState();
            refreshUI();

            setTimeout(function () {
              if (runnerState === 'running') runCurrentPhase();
            }, INTER_PHASE_DELAY);
          });
        }, POST_SEND_DELAY);
      });
    }, 500);
  }

  // ============================================================
  // LOGGING
  // ============================================================

  function addLog(msg) {
    if (!logEl) return;
    var entry = document.createElement('div');
    entry.style.cssText = 'font-size:11px;color:#bbb;padding:3px 0;border-bottom:1px solid #2a2a28;word-wrap:break-word;';
    var time = new Date().toLocaleTimeString();
    entry.textContent = '[' + time + '] ' + msg;
    logEl.insertBefore(entry, logEl.firstChild);
    while (logEl.children.length > 50) logEl.removeChild(logEl.lastChild);
  }

