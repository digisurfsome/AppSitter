// ==UserScript==
// @name         AppSitter
// @namespace    https://github.com/digisurfsome/AppSitter
// @version      3.0
// @description  Auto-feeds build phases into AI chat sequentially — watches for completion and advances automatically
// @author       AppSitter
// @match        https://claude.ai/*
// @match        https://chatgpt.com/*
// @match        https://chat.openai.com/*
// @match        https://gemini.google.com/*
// @grant        GM_xmlhttpRequest
// @grant        GM.xmlHttpRequest
// @connect      api.github.com
// @run-at       document-idle
// ==/UserScript==

(function () {
  'use strict';

  // ============================================================
  // CONSTANTS
  // ============================================================

  var STORAGE = {
    phases: 'pb-phases',
    currentPhase: 'pb-current-phase',
    repoUrl: 'pb-repo-url',
    repoName: 'pb-repo-name',
    buildName: 'pb-build-name',
    state: 'pb-state',
    panelOpen: 'pb-panel-open',
    autoCommit: 'pb-auto-commit',
    zoom: 'pb-zoom',
    githubToken: 'pb-github-token',
    githubUser: 'pb-github-user'
  };

  var BOILERPLATES = {
    web: { owner: 'digisurfsome', repo: 'Web-BoilerPlate-D2D', label: 'Web App' },
    mobile: { owner: 'digisurfsome', repo: 'Mobile-BoilerPlate-D2D', label: 'Mobile App (Coming Soon)', disabled: true },
    both: { label: 'Both (Coming Soon)', disabled: true },
    none: { owner: null, repo: null, label: 'No Boilerplate' }
  };

  var IDLE_THRESHOLD = 5000;
  var POLL_INTERVAL = 2000;
  var POST_SEND_DELAY = 3000;
  var INTER_PHASE_DELAY = 2500;
  var SEND_RETRY_DELAY = 600;
  var SEND_MAX_RETRIES = 4;
  var PHASE_MARKER_RE = /---\s*PHASE\s+(\d+)\s*---/gi;

  var AUTO_COMMIT_MSG = 'All phases are now complete. Please commit all your changes with a clear, descriptive commit message summarizing what was done, then push to your current branch. Use: git add -A && git commit -m "your message" && git push';

  var PHASE_COMMIT_FOOTER = '\n\nIMPORTANT: When you are finished with this task, commit all changes with a clear, descriptive commit message and push to your current branch. Do NOT write a summary or review in the chat after you are done — put your summary inside the commit message instead. Just commit, push, and stop.';

  var REPO_SELECT_TIMEOUT = 500;
  var REPO_SEARCH_DELAY = 800;
  var REPO_CLICK_DELAY = 500;
  var RENAME_DELAY = 30000;

  // ============================================================
  // STATE
  // ============================================================

  var phases = [];
  var currentPhaseIndex = 0;
  var runnerState = 'idle';
  var lastMutationTime = 0;
  var mutationObserver = null;
  var completionPollTimer = null;
  var onCompletionCb = null;
  var panelEl = null;
  var phaseListEl = null;
  var logEl = null;
  var statusTextEl = null;
  var phaseCountEl = null;
  var startBtn = null;
  var pauseBtn = null;
  var stopBtn = null;
  var skipBtn = null;
  var toggleBtn = null;
  var renameTimer = null;
  var zoomLevel = 100;

  // ============================================================
  // SITE DETECTION
  // ============================================================

  function detectSite() {
    var host = window.location.hostname;
    if (host.indexOf('claude.ai') !== -1) return 'claude';
    if (host.indexOf('chatgpt.com') !== -1 || host.indexOf('chat.openai.com') !== -1) return 'chatgpt';
    if (host.indexOf('gemini.google.com') !== -1) return 'gemini';
    return 'unknown';
  }

  var SITE = detectSite();

  // ============================================================
  // CHAT INPUT DETECTION & INJECTION
  // ============================================================

  function getEditor() {
    var el;
    el = document.querySelector('.ProseMirror[contenteditable="true"]');
    if (el) return { el: el, type: 'prosemirror' };
    el = document.querySelector('div[data-placeholder][contenteditable="true"]');
    if (el) return { el: el, type: 'prosemirror' };
    el = document.querySelector('#prompt-textarea');
    if (el) return { el: el, type: 'prosemirror' };
    el = document.querySelector('.ql-editor[contenteditable="true"]');
    if (el) return { el: el, type: 'prosemirror' };
    el = document.querySelector('div[contenteditable="true"]');
    if (el) return { el: el, type: 'prosemirror' };
    el = document.querySelector('textarea');
    if (el) return { el: el, type: 'textarea' };
    return null;
  }

  function injectText(text) {
    var editor = getEditor();
    if (!editor) return false;
    var el = editor.el;
    var type = editor.type;

    if (type === 'textarea') {
      var setter = Object.getOwnPropertyDescriptor(
        window.HTMLTextAreaElement.prototype, 'value'
      ).set;
      setter.call(el, text);
      el.dispatchEvent(new Event('input', { bubbles: true }));
      el.focus();
      return true;
    }

    el.focus();
    var sel = window.getSelection();
    var range = document.createRange();
    range.selectNodeContents(el);
    sel.removeAllRanges();
    sel.addRange(range);
    var ok = document.execCommand('insertText', false, text);
    if (!ok) {
      var cd = new DataTransfer();
      cd.setData('text/plain', text);
      el.dispatchEvent(new ClipboardEvent('paste', {
        clipboardData: cd, bubbles: true, cancelable: true
      }));
    }
    return true;
  }

  // ============================================================
  // SEND BUTTON DETECTION & CLICKING
  // ============================================================

  var SEND_SELECTORS = {
    claude: [
      'button[aria-label="Send Message"]',
      'button[aria-label="Send message"]',
      'button[aria-label="Send"]',
      'button[data-testid="send-button"]'
    ],
    chatgpt: [
      'button[data-testid="send-button"]',
      'button[aria-label="Send prompt"]',
      'button[aria-label="Send"]'
    ],
    gemini: [
      'button[aria-label="Send message"]',
      'button.send-button',
      '.send-button-container button'
    ]
  };

  var STOP_SELECTORS = {
    claude: [
      'button[aria-label="Stop Response"]',
      'button[aria-label="Stop response"]',
      'button[aria-label="Stop"]'
    ],
    chatgpt: [
      'button[aria-label="Stop generating"]',
      'button[data-testid="stop-button"]',
      'button[aria-label="Stop"]'
    ],
    gemini: [
      'button[aria-label="Stop"]'
    ]
  };

  function findButtonFromMap(selectorMap) {
    var primary = selectorMap[SITE] || [];
    var all = primary.slice();
    var keys = Object.keys(selectorMap);
    for (var k = 0; k < keys.length; k++) {
      if (keys[k] !== SITE) {
        var extras = selectorMap[keys[k]];
        for (var j = 0; j < extras.length; j++) all.push(extras[j]);
      }
    }
    for (var i = 0; i < all.length; i++) {
      var btn = document.querySelector(all[i]);
      if (btn) return btn;
    }
    return null;
  }

  function isSendAvailable() {
    var btn = findButtonFromMap(SEND_SELECTORS);
    return btn && !btn.disabled;
  }

  function isStopVisible() {
    return !!findButtonFromMap(STOP_SELECTORS);
  }

  function attemptSend(retries, callback) {
    var btn = findButtonFromMap(SEND_SELECTORS);
    if (btn && !btn.disabled) {
      btn.click();
      if (callback) callback(true);
      return;
    }
    // Fallback: Enter key
    var editor = getEditor();
    if (editor) {
      editor.el.dispatchEvent(new KeyboardEvent('keydown', {
        key: 'Enter', code: 'Enter', keyCode: 13, which: 13,
        bubbles: true, cancelable: true
      }));
      if (callback) callback(true);
      return;
    }
    if (retries > 0) {
      setTimeout(function () {
        attemptSend(retries - 1, callback);
      }, SEND_RETRY_DELAY);
    } else {
      if (callback) callback(false);
    }
  }

  // ============================================================
  // COMPLETION DETECTION
  // ============================================================

  function getChatContainer() {
    var selectors = [
      '[class*="conversation"]',
      '[class*="chat-messages"]',
      '[role="presentation"]',
      'main',
      '[role="main"]'
    ];
    for (var i = 0; i < selectors.length; i++) {
      var el = document.querySelector(selectors[i]);
      if (el) return el;
    }
    return document.body;
  }

  function startCompletionDetection(callback) {
    stopCompletionDetection();
    onCompletionCb = callback;
    lastMutationTime = Date.now();

    var container = getChatContainer();
    mutationObserver = new MutationObserver(function () {
      lastMutationTime = Date.now();
    });
    mutationObserver.observe(container, {
      childList: true, subtree: true, characterData: true
    });

    completionPollTimer = setInterval(function () {
      var idle = Date.now() - lastMutationTime;
      var sendOk = isSendAvailable();
      var stopUp = isStopVisible();
      if (idle >= IDLE_THRESHOLD && sendOk && !stopUp) {
        stopCompletionDetection();
        if (onCompletionCb) onCompletionCb();
      }
    }, POLL_INTERVAL);
  }

  function stopCompletionDetection() {
    if (mutationObserver) {
      mutationObserver.disconnect();
      mutationObserver = null;
    }
    if (completionPollTimer) {
      clearInterval(completionPollTimer);
      completionPollTimer = null;
    }
  }

  // ============================================================
  // PERSISTENCE
  // ============================================================

  function loadState() {
    try {
      var p = localStorage.getItem(STORAGE.phases);
      if (p) phases = JSON.parse(p);
      var c = localStorage.getItem(STORAGE.currentPhase);
      if (c !== null) currentPhaseIndex = parseInt(c, 10);
      var s = localStorage.getItem(STORAGE.state);
      if (s && s !== 'running') runnerState = s;
      if (s === 'running') runnerState = 'paused';
    } catch (_) {}
  }

  function saveState() {
    localStorage.setItem(STORAGE.phases, JSON.stringify(phases));
    localStorage.setItem(STORAGE.currentPhase, String(currentPhaseIndex));
    localStorage.setItem(STORAGE.state, runnerState);
  }

  function getRepoUrl() {
    return localStorage.getItem(STORAGE.repoUrl) || '';
  }

  function saveRepoUrl(url) {
    localStorage.setItem(STORAGE.repoUrl, url);
  }

  function getAutoCommit() {
    return localStorage.getItem(STORAGE.autoCommit) === 'true';
  }

  function saveAutoCommit(val) {
    localStorage.setItem(STORAGE.autoCommit, val ? 'true' : 'false');
  }

  function getRepoName() {
    return localStorage.getItem(STORAGE.repoName) || '';
  }

  function saveRepoName(name) {
    localStorage.setItem(STORAGE.repoName, name);
  }

  function getBuildName() {
    return localStorage.getItem(STORAGE.buildName) || '';
  }

  function saveBuildName(name) {
    localStorage.setItem(STORAGE.buildName, name);
  }

  function getZoom() {
    var z = parseInt(localStorage.getItem(STORAGE.zoom), 10);
    return (z && z >= 30 && z <= 300) ? z : 100;
  }

  function saveZoom(val) {
    localStorage.setItem(STORAGE.zoom, String(val));
  }

  function extractRepoName(url) {
    if (!url) return '';
    var match = url.match(/github\.com\/[^\/]+\/([^\/\s\?#]+)/i);
    if (match) return match[1].replace(/\.git$/, '');
    if (url.indexOf('/') === -1 && url.indexOf('.') === -1) return url.trim();
    return '';
  }

  function getGitHubToken() { return localStorage.getItem(STORAGE.githubToken) || ''; }
  function saveGitHubToken(t) { localStorage.setItem(STORAGE.githubToken, t); }
  function getGitHubUser() { return localStorage.getItem(STORAGE.githubUser) || ''; }
  function saveGitHubUser(u) { localStorage.setItem(STORAGE.githubUser, u); }

  function gmFetch(url, options) {
    options = options || {};
    var method = options.method || 'GET';
    var headers = options.headers || {};
    var body = options.body || null;

    function wrapResponse(status, responseText) {
      return {
        ok: status >= 200 && status < 300,
        status: status,
        json: function () { return Promise.resolve(JSON.parse(responseText)); },
        text: function () { return Promise.resolve(responseText); }
      };
    }

    // Try GM_xmlhttpRequest / GM.xmlHttpRequest first (cross-origin), fall back to fetch
    var gmXhr = (typeof GM_xmlhttpRequest === 'function') ? GM_xmlhttpRequest
              : (typeof GM !== 'undefined' && GM && typeof GM.xmlHttpRequest === 'function') ? GM.xmlHttpRequest.bind(GM)
              : null;

    if (gmXhr) {
      return new Promise(function (resolve, reject) {
        gmXhr({
          method: method,
          url: url,
          headers: headers,
          data: body,
          timeout: 15000,
          onload: function (resp) { resolve(wrapResponse(resp.status, resp.responseText)); },
          onerror: function (err) { reject(new Error('GM_xmlhttpRequest error: ' + JSON.stringify(err))); },
          ontimeout: function () { reject(new Error('Request timed out')); }
        });
      });
    }

    // Fallback: regular fetch
    return fetch(url, { method: method, headers: headers, body: body })
      .then(function (resp) {
        return resp.text().then(function (text) {
          return wrapResponse(resp.status, text);
        });
      });
  }

  function slugify(name) {
    return name.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9\-]/g, '');
  }

  // ============================================================
  // PHASE PARSING & VARIABLES
  // ============================================================

  function parsePhases(rawText) {
    PHASE_MARKER_RE.lastIndex = 0;
    var markers = [];
    var match;
    while ((match = PHASE_MARKER_RE.exec(rawText)) !== null) {
      markers.push({ index: match.index, end: match.index + match[0].length, num: parseInt(match[1], 10) });
    }

    if (markers.length === 0) {
      var trimmed = rawText.trim();
      if (trimmed) return [{ number: 1, content: trimmed, status: 'pending' }];
      return [];
    }

    var result = [];
    for (var i = 0; i < markers.length; i++) {
      var start = markers[i].end;
      var end = (i + 1 < markers.length) ? markers[i + 1].index : rawText.length;
      var content = rawText.substring(start, end).trim();
      if (content) {
        result.push({ number: markers[i].num, content: content, status: 'pending' });
      }
    }
    return result;
  }

  function substituteVars(text) {
    var repoUrl = getRepoUrl();
    var repoName = getRepoName();
    var buildName = getBuildName();
    return text
      .replace(/\{\{REPO_URL\}\}/gi, repoUrl)
      .replace(/\{\{REPO_NAME\}\}/gi, repoName)
      .replace(/\{\{BUILD_NAME\}\}/gi, buildName)
      .replace(/\{\{PHASE_NUMBER\}\}/gi, String(currentPhaseIndex + 1))
      .replace(/\{\{TOTAL_PHASES\}\}/gi, String(phases.length));
  }

  function wrapPhaseContent(text, phaseIdx) {
    var wrapped = '';
    var repoName = getRepoName();
    var buildName = getBuildName();

    // First phase: prepend build title for auto-naming the conversation
    if (phaseIdx === 0 && (buildName || repoName)) {
      var title = buildName || ('Phase Build - ' + repoName);
      wrapped += '# ' + title + '\n\n';
    }

    wrapped += text;

    // Append commit + no-summary instruction
    if (getAutoCommit()) {
      wrapped += PHASE_COMMIT_FOOTER;
    }

    return wrapped;
  }

  // ============================================================
  // REPO DROPDOWN SELECTION (Claude Code Web)
  // ============================================================

  function selectRepoInDropdown(repoName, callback) {
    if (!repoName) {
      addLog('No repo name set. Skipping repo selection.');
      if (callback) callback();
      return;
    }
    if (SITE !== 'claude') {
      addLog('Repo selection only available on Claude. Skipping.');
      if (callback) callback();
      return;
    }

    addLog('Selecting repo: ' + repoName + '...');

    // Step 1: Find the repo selector button in the top-left area
    // Claude Code Web shows the repo name in a clickable button near the top-left
    var repoBtn = null;

    // Try specific selectors first
    var btnSelectors = [
      'button[data-testid="repo-selector"]',
      'button[aria-label*="repo" i]',
      'button[aria-label*="repository" i]',
      '[class*="repo-selector"] button',
      '[class*="repoSelector"] button'
    ];

    for (var s = 0; s < btnSelectors.length; s++) {
      repoBtn = document.querySelector(btnSelectors[s]);
      if (repoBtn) break;
    }

    // Fallback: look for buttons in the top-left area (rect.left < 300, rect.top < 80)
    // that contain short text (likely a repo name like "Ap..." or "AppSitter")
    if (!repoBtn) {
      var allBtns = document.querySelectorAll('button, [role="button"]');
      for (var i = 0; i < allBtns.length; i++) {
        var el = allBtns[i];
        var rect = el.getBoundingClientRect();
        if (rect.left < 300 && rect.top < 80 && rect.width > 20 && rect.height > 10) {
          var text = el.textContent.trim();
          // Skip known non-repo buttons
          if (text && text.length > 0 && text.length < 40 &&
              !text.match(/^(Auto|Send|Stop|Pause|Start|Skip|Save|Edit|Delete|Archive|Rename|Share|New|PB|Settings|Help|Search|\+)/i) &&
              !el.closest('#pb-panel') && !el.closest('#pb-toggle')) {
            repoBtn = el;
            break;
          }
        }
      }
    }

    if (!repoBtn) {
      addLog('WARNING: Could not find repo selector button. Skipping.');
      if (callback) callback();
      return;
    }

    repoBtn.click();
    addLog('Clicked repo dropdown.');

    // Step 2: Wait for dropdown to open, find the search input
    setTimeout(function () {
      var searchInput = null;

      // Look for visible search/filter inputs that appeared in the dropdown area
      var inputs = document.querySelectorAll(
        'input[type="text"], input[type="search"], input:not([type]), ' +
        'input[placeholder*="search" i], input[placeholder*="repo" i], input[placeholder*="filter" i]'
      );

      for (var i = 0; i < inputs.length; i++) {
        var inp = inputs[i];
        var rect = inp.getBoundingClientRect();
        if (rect.width > 0 && rect.height > 0 && rect.left < 400 && rect.top < 300) {
          // Make sure it's not our own panel's input
          if (!inp.closest('#pb-panel')) {
            searchInput = inp;
            break;
          }
        }
      }

      // Fallback: find input inside any popover/dropdown/dialog that appeared
      if (!searchInput) {
        var containers = document.querySelectorAll(
          '[role="listbox"], [role="dialog"], [role="menu"], ' +
          '[class*="dropdown"], [class*="popover"], [class*="popup"], [class*="modal"]'
        );
        for (var c = 0; c < containers.length; c++) {
          var inp2 = containers[c].querySelector('input');
          if (inp2 && !inp2.closest('#pb-panel')) {
            searchInput = inp2;
            break;
          }
        }
      }

      if (!searchInput) {
        addLog('WARNING: Could not find repo search input. Skipping.');
        document.body.click();
        if (callback) callback();
        return;
      }

      // Step 3: Type the repo name into the search box
      searchInput.focus();
      var nativeSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set;
      nativeSetter.call(searchInput, repoName);
      searchInput.dispatchEvent(new Event('input', { bubbles: true }));
      searchInput.dispatchEvent(new Event('change', { bubbles: true }));
      addLog('Typed repo name: ' + repoName);

      // Step 4: Wait for filtering, then click the matching result
      setTimeout(function () {
        var found = false;
        var lowerName = repoName.toLowerCase();

        // Look for matching items in dropdown results
        var itemSelectors = [
          '[role="option"]',
          '[role="menuitem"]',
          '[class*="dropdown"] li',
          '[class*="dropdown"] [class*="item"]',
          '[class*="popover"] li',
          '[class*="popover"] [class*="item"]',
          '[class*="list"] [class*="item"]'
        ];

        for (var s = 0; s < itemSelectors.length; s++) {
          var items = document.querySelectorAll(itemSelectors[s]);
          for (var i = 0; i < items.length; i++) {
            var itemText = items[i].textContent.trim().toLowerCase();
            if (itemText.indexOf(lowerName) !== -1 && !items[i].closest('#pb-panel')) {
              items[i].click();
              addLog('Selected repo: ' + repoName);
              found = true;
              break;
            }
          }
          if (found) break;
        }

        // Broader fallback: any clickable element in dropdown area matching the name
        if (!found) {
          var clickables = document.querySelectorAll('a, button, [role="button"], div[tabindex], li, span[tabindex]');
          for (var j = 0; j < clickables.length; j++) {
            var cel = clickables[j];
            var crect = cel.getBoundingClientRect();
            if (crect.left < 400 && crect.top > 40 && crect.top < 400 && crect.width > 0) {
              var celText = cel.textContent.trim().toLowerCase();
              if (celText.indexOf(lowerName) !== -1 && celText.length < 100 && !cel.closest('#pb-panel')) {
                cel.click();
                addLog('Selected repo: ' + repoName);
                found = true;
                break;
              }
            }
          }
        }

        if (!found) {
          addLog('WARNING: Could not find "' + repoName + '" in dropdown. Closing.');
          document.body.click();
        }

        setTimeout(function () {
          if (callback) callback();
        }, REPO_CLICK_DELAY);
      }, REPO_SEARCH_DELAY);
    }, REPO_SELECT_TIMEOUT);
  }

  // ============================================================
  // CONVERSATION RENAME (Claude Code Web)
  // ============================================================

  function renameConversation(name) {
    if (!name || SITE !== 'claude') return;
    addLog('Attempting to rename conversation: ' + name + '...');

    // Step 1: Find the conversation title/dropdown button at top-center
    var titleBtn = null;
    var selectors = [
      '[class*="conversation"] button',
      'header [class*="title"]',
      'button[class*="title"]'
    ];
    for (var s = 0; s < selectors.length; s++) {
      titleBtn = document.querySelector(selectors[s]);
      if (titleBtn && !titleBtn.closest('#pb-panel')) break;
      titleBtn = null;
    }

    // Fallback: look for a clickable element at top-center with a dropdown arrow
    if (!titleBtn) {
      var candidates = document.querySelectorAll('button, [role="button"], span[class*="title"]');
      for (var i = 0; i < candidates.length; i++) {
        var el = candidates[i];
        var rect = el.getBoundingClientRect();
        // Top center area
        if (rect.top < 60 && rect.left > 200 && rect.right < (window.innerWidth - 200) && rect.width > 50) {
          if (!el.closest('#pb-panel')) {
            titleBtn = el;
            break;
          }
        }
      }
    }

    if (!titleBtn) {
      addLog('WARNING: Could not find conversation title button. Skipping rename.');
      return;
    }

    titleBtn.click();
    addLog('Clicked conversation title dropdown.');

    // Step 2: Wait for dropdown menu, click Rename
    setTimeout(function () {
      var renameBtn = null;
      var menuItems = document.querySelectorAll('[role="menuitem"], [role="option"], button, a');
      for (var i = 0; i < menuItems.length; i++) {
        var itemText = menuItems[i].textContent.trim().toLowerCase();
        if (itemText === 'rename' && !menuItems[i].closest('#pb-panel')) {
          renameBtn = menuItems[i];
          break;
        }
      }

      if (!renameBtn) {
        addLog('WARNING: Could not find Rename option. Closing menu.');
        document.body.click();
        return;
      }

      renameBtn.click();
      addLog('Clicked Rename.');

      // Step 3: Wait for editable title field, type the name
      setTimeout(function () {
        // Look for an editable input that appeared in the title area
        var editableInput = null;
        var inputs = document.querySelectorAll('input[type="text"], input:not([type]), [contenteditable="true"]');
        for (var i = 0; i < inputs.length; i++) {
          var inp = inputs[i];
          var rect = inp.getBoundingClientRect();
          if (rect.top < 60 && rect.left > 100 && rect.width > 50 && !inp.closest('#pb-panel')) {
            editableInput = inp;
            break;
          }
        }

        if (!editableInput) {
          addLog('WARNING: Could not find editable title field. Skipping.');
          return;
        }

        editableInput.focus();
        if (editableInput.tagName === 'INPUT') {
          var nativeSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set;
          nativeSetter.call(editableInput, name);
          editableInput.dispatchEvent(new Event('input', { bubbles: true }));
          editableInput.dispatchEvent(new Event('change', { bubbles: true }));
        } else {
          // contenteditable
          var sel = window.getSelection();
          var range = document.createRange();
          range.selectNodeContents(editableInput);
          sel.removeAllRanges();
          sel.addRange(range);
          document.execCommand('insertText', false, name);
        }

        // Click outside to save
        setTimeout(function () {
          editableInput.blur();
          document.body.click();
          addLog('Conversation renamed to: ' + name);
        }, 300);
      }, 500);
    }, 500);
  }

  // ============================================================
  // PHASE RUNNER
  // ============================================================

  function sendAutoCommit() {
    addLog('Auto-commit enabled. Sending commit instruction...');
    var repoUrl = getRepoUrl();
    var commitText = AUTO_COMMIT_MSG;
    if (repoUrl) {
      commitText += '\n\nRepository: ' + repoUrl;
    }
    var injected = injectText(commitText);
    if (!injected) {
      addLog('ERROR: Could not inject commit message. No chat input found.');
      return;
    }
    setTimeout(function () {
      attemptSend(SEND_MAX_RETRIES, function (sent) {
        if (sent) {
          addLog('Commit instruction sent successfully.');
        } else {
          addLog('WARNING: Could not auto-send commit instruction. Please click Send manually.');
        }
      });
    }, 500);
  }

  function runCurrentPhase() {
    if (currentPhaseIndex >= phases.length) {
      runnerState = 'complete';
      saveState();
      refreshUI();
      addLog('All phases complete!');
      if (getAutoCommit()) {
        setTimeout(function () { sendAutoCommit(); }, INTER_PHASE_DELAY);
      }
      return;
    }
    if (runnerState !== 'running') return;

    var phase = phases[currentPhaseIndex];
    phase.status = 'running';
    saveState();
    refreshUI();

    // Step 1: Auto-select repo in dropdown (always on when repo name is set)
    var repoName = getRepoName();
    var shouldSelectRepo = repoName && SITE === 'claude';

    function injectAndSend() {
      addLog('Injecting Phase ' + phase.number + '...');

      var text = substituteVars(phase.content);
      text = wrapPhaseContent(text, currentPhaseIndex);
      var injected = injectText(text);
      if (!injected) {
        addLog('ERROR: No chat input found. Pausing.');
        runnerState = 'paused';
        saveState();
        refreshUI();
        return;
      }

      addLog('Text injected. Attempting to send...');

      setTimeout(function () {
        if (runnerState !== 'running') return;

        attemptSend(SEND_MAX_RETRIES, function (sent) {
          if (!sent) {
            addLog('WARNING: Could not auto-send. Please click Send manually. Babysitter will still watch for completion.');
          } else {
            addLog('Phase ' + phase.number + ' sent. Watching for completion...');
          }

          setTimeout(function () {
            if (runnerState !== 'running') return;

            startCompletionDetection(function () {
              phase.status = 'complete';
              addLog('Phase ' + phase.number + ' complete!');
              currentPhaseIndex++;
              saveState();
              refreshUI();

              setTimeout(function () {
                if (runnerState === 'running') runCurrentPhase();
              }, INTER_PHASE_DELAY);
            });
          }, POST_SEND_DELAY);
        });
      }, 500);
    }

    if (shouldSelectRepo) {
      selectRepoInDropdown(repoName, function () {
        if (runnerState !== 'running') return;
        injectAndSend();
      });
    } else {
      injectAndSend();
    }
  }

