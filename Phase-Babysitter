    document.body.appendChild(panelEl);

    // ============================================================
    // EVENT HANDLERS
    // ============================================================

    // Zoom handlers
    zoomMinusBtn.addEventListener('click', function () {
      zoomLevel = Math.max(30, zoomLevel - 10);
      zoomInput.value = zoomLevel;
      saveZoom(zoomLevel);
      applyZoom();
    });
    zoomPlusBtn.addEventListener('click', function () {
      zoomLevel = Math.min(300, zoomLevel + 10);
      zoomInput.value = zoomLevel;
      saveZoom(zoomLevel);
      applyZoom();
    });
    zoomInput.addEventListener('change', function () {
      var val = parseInt(zoomInput.value, 10);
      if (val && val >= 30 && val <= 300) {
        zoomLevel = val;
        saveZoom(zoomLevel);
        applyZoom();
      } else {
        zoomInput.value = zoomLevel;
      }
    });
    zoomInput.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') zoomInput.blur();
    });

    toggleBtn.addEventListener('click', function () {
      panelEl.classList.toggle('pb-hidden');
      localStorage.setItem(STORAGE.panelOpen, !panelEl.classList.contains('pb-hidden'));
    });

    minimizeBtn.addEventListener('click', function () {
      panelEl.classList.add('pb-hidden');
      localStorage.setItem(STORAGE.panelOpen, 'false');
    });

    // Read more toggle (GitHub info)
    readMoreLink.addEventListener('click', function () {
      var expanded = repoInfo.classList.toggle('pb-expanded');
      readMoreLink.textContent = expanded ? 'Read less \u25B2' : 'Read more \u25BC';
    });

    // Token help button — toggle instructions
    tokenHelpBtn.addEventListener('click', function () {
      var visible = stepsList.style.display !== 'none';
      stepsList.style.display = visible ? 'none' : 'block';
      tokenHelpBtn.textContent = visible ? 'How To Get Token' : 'Hide Steps';
    });

    // Token setup button — expand to show setup
    tokenSetupBtn.addEventListener('click', function () {
      showTokenExpanded();
      // Show instructions by default on first setup, hide on replace
      if (getGitHubToken()) {
        stepsList.style.display = 'none';
        tokenHelpBtn.textContent = 'How To Get Token';
      } else {
        stepsList.style.display = 'block';
        tokenHelpBtn.textContent = 'Hide Steps';
      }
    });

    // Token cancel — collapse back
    tokenCancelBtn.addEventListener('click', function () {
      showTokenCollapsed();
    });

    // Token save — verify with GitHub API
    tokenSaveBtn.addEventListener('click', function () {
      var token = tokenInput.value.trim();
      if (!token) { addLog('Enter a token first.'); return; }
      tokenSaveBtn.textContent = 'Verifying...';
      tokenSaveBtn.disabled = true;
      gmFetch('https://api.github.com/user', {
        method: 'GET',
        headers: { 'Authorization': 'Bearer ' + token, 'Accept': 'application/vnd.github+json' }
      }).then(function (resp) {
        if (!resp.ok) {
          addLog('Invalid token (HTTP ' + resp.status + '). Check permissions.');
          tokenSaveBtn.textContent = 'Save & Verify';
          tokenSaveBtn.disabled = false;
          return;
        }
        return resp.json().then(function (data) {
          saveGitHubToken(token);
          saveGitHubUser(data.login);
          tokenInput.value = '';
          createBtn.disabled = false;
          addLog('GitHub token verified. User: ' + data.login);
          tokenSaveBtn.textContent = 'Save & Verify';
          tokenSaveBtn.disabled = false;
          showTokenCollapsed();
        });
      }).catch(function (err) {
        addLog('Network error verifying token. ' + (err && err.message ? err.message : String(err)));
        tokenSaveBtn.textContent = 'Save & Verify';
        tokenSaveBtn.disabled = false;
      });
    });

    // App name slugify on blur
    appNameInput.addEventListener('blur', function () {
      appNameInput.value = slugify(appNameInput.value);
    });

    // Update create button disabled state when app name changes
    appNameInput.addEventListener('input', function () {
      createBtn.disabled = !getGitHubToken() || !appNameInput.value.trim();
    });

    // Visibility toggle
    privateBtn.addEventListener('click', function () {
      isPrivate = true;
      privateBtn.className = 'pb-btn pb-btn-primary';
      publicBtn.className = 'pb-btn';
    });
    publicBtn.addEventListener('click', function () {
      isPrivate = false;
      publicBtn.className = 'pb-btn pb-btn-primary';
      privateBtn.className = 'pb-btn';
    });

    // Create App button
    createBtn.addEventListener('click', function () {
      var appName = slugify(appNameInput.value.trim());
      appNameInput.value = appName;
      if (!appName) { addLog('Enter an app name.'); return; }
      var token = getGitHubToken();
      var ghUser = getGitHubUser();
      if (!token || !ghUser) { addLog('Save a valid GitHub token first.'); return; }

      var bpKey = bpSelect.value;
      var bp = BOILERPLATES[bpKey];

      // UI feedback
      createBtn.textContent = 'Creating...';
      createBtn.disabled = true;
      appNameInput.disabled = true;
      privateBtn.disabled = true;
      publicBtn.disabled = true;
      bpSelect.disabled = true;

      var headers = {
        'Authorization': 'Bearer ' + token,
        'Accept': 'application/vnd.github+json',
        'Content-Type': 'application/json'
      };

      var url, body2;
      if (bpKey !== 'none' && bp.owner && bp.repo) {
        // Template repo API
        url = 'https://api.github.com/repos/' + bp.owner + '/' + bp.repo + '/generate';
        body2 = JSON.stringify({
          owner: ghUser,
          name: appName,
          private: isPrivate,
          description: 'Created by AppSitter'
        });
      } else {
        // Regular create repo API
        url = 'https://api.github.com/user/repos';
        body2 = JSON.stringify({
          name: appName,
          private: isPrivate,
          auto_init: true,
          description: 'Created by AppSitter'
        });
      }

      addLog('Creating repo ' + ghUser + '/' + appName + '...');

      gmFetch(url, { method: 'POST', headers: headers, body: body2 }).then(function (resp) {
        if (resp.ok) {
          return resp.json().then(function (data) {
            var repoUrl = 'https://github.com/' + ghUser + '/' + appName;
            // Auto-fill existing repo fields
            repoInput.value = repoUrl;
            saveRepoUrl(repoUrl);
            saveRepoName(appName);
            repoNameDisplay.textContent = 'Repo: ' + appName;

            var bpLabel2 = (bpKey !== 'none') ? bp.label + ' boilerplate' : 'no boilerplate';
            addLog('Created repo: ' + ghUser + '/' + appName + ' with ' + bpLabel2);
            appNameInput.value = '';
          });
        } else {
          return resp.json().then(function (err) {
            var msg = (err.message || 'Unknown error');
            if (resp.status === 401) msg = 'Invalid token';
            else if (resp.status === 422) msg = 'Repo name already exists or invalid';
            else if (resp.status === 403) msg = 'Token lacks required permissions';
            addLog('Failed to create repo: ' + resp.status + ' — ' + msg);
          }).catch(function () {
            addLog('Failed to create repo: HTTP ' + resp.status);
          });
        }
      }).catch(function (err) {
        addLog('Network error creating repo: ' + (err.message || err));
      }).then(function () {
        // Re-enable inputs
        createBtn.textContent = 'Create App';
        createBtn.disabled = !getGitHubToken() || !appNameInput.value.trim();
        appNameInput.disabled = false;
        privateBtn.disabled = false;
        publicBtn.disabled = false;
        bpSelect.disabled = false;
      });
    });

    // Repo URL save — also auto-extracts repo name
    repoSaveBtn.addEventListener('click', function () {
      var url = repoInput.value.trim();
      saveRepoUrl(url);
      var extracted = extractRepoName(url);
      if (extracted) {
        saveRepoName(extracted);
        repoNameDisplay.textContent = 'Repo: ' + extracted;
        addLog('Repo saved. Name: ' + extracted);
      } else {
        addLog('Repo URL saved.');
      }
    });

    commitCheckbox.addEventListener('change', function () {
      saveAutoCommit(commitCheckbox.checked);
      addLog('Auto-commit ' + (commitCheckbox.checked ? 'enabled' : 'disabled') + '.');
    });

    // Build Name save
    buildNameSaveBtn.addEventListener('click', function () {
      saveBuildName(buildNameInput.value.trim());
      addLog('Build name saved: ' + buildNameInput.value.trim());
    });

    parseBtn.addEventListener('click', function () {
      var raw = phaseTextarea.value;
      if (!raw.trim()) {
        addLog('Nothing to parse.');
        return;
      }
      phases = parsePhases(raw);
      currentPhaseIndex = 0;
      runnerState = 'idle';
      saveState();
      refreshUI();
      addLog('Parsed ' + phases.length + ' phase(s).');
      phaseTextarea.value = '';
    });

    clearBtn.addEventListener('click', function () {
      if (runnerState === 'running') {
        addLog('Stop the runner before clearing.');
        return;
      }
      phases = [];
      currentPhaseIndex = 0;
      runnerState = 'idle';
      stopCompletionDetection();
      saveState();
      refreshUI();
      phaseTextarea.value = '';
      addLog('All phases cleared.');
    });

    startBtn.addEventListener('click', function () {
      if (phases.length === 0) {
        addLog('No phases loaded. Parse phases first.');
        return;
      }
      if (runnerState === 'complete') {
        currentPhaseIndex = 0;
        for (var i = 0; i < phases.length; i++) phases[i].status = 'pending';
      }
      runnerState = 'running';
      saveState();
      refreshUI();
      addLog('Runner started.');

      // Schedule delayed conversation rename (~30s after start)
      if (renameTimer) clearTimeout(renameTimer);
      var buildName = getBuildName();
      var rName = getRepoName();
      if (buildName || rName) {
        renameTimer = setTimeout(function () {
          renameConversation(buildName || ('Phase Build - ' + rName));
        }, RENAME_DELAY);
      }

      runCurrentPhase();
    });

    pauseBtn.addEventListener('click', function () {
      if (runnerState !== 'running') return;
      runnerState = 'paused';
      stopCompletionDetection();
      saveState();
      refreshUI();
      addLog('Runner paused.');
    });

    stopBtn.addEventListener('click', function () {
      runnerState = 'idle';
      stopCompletionDetection();
      currentPhaseIndex = 0;
      for (var i = 0; i < phases.length; i++) phases[i].status = 'pending';
      saveState();
      refreshUI();
      addLog('Runner stopped. Reset to Phase 1.');
    });

    skipBtn.addEventListener('click', function () {
      if (phases.length === 0) return;
      if (currentPhaseIndex < phases.length) {
        phases[currentPhaseIndex].status = 'complete';
        addLog('Skipped Phase ' + phases[currentPhaseIndex].number + '.');
        currentPhaseIndex++;
      }
      stopCompletionDetection();
      saveState();
      refreshUI();
      if (runnerState === 'running' && currentPhaseIndex < phases.length) {
        setTimeout(function () { runCurrentPhase(); }, 500);
      } else if (currentPhaseIndex >= phases.length) {
        runnerState = 'complete';
        saveState();
        refreshUI();
        addLog('All phases complete!');
      }
    });

    // Initial render
    refreshUI();
    if (phases.length > 0) {
      addLog('Restored ' + phases.length + ' phase(s). State: ' + runnerState + '. Current: Phase ' + (currentPhaseIndex + 1) + '.');
    }
  }

  // ============================================================
  // UI REFRESH
  // ============================================================

  function refreshUI() {
    if (!panelEl) return;
    refreshStatus();
    refreshPhaseList();
    refreshControls();
  }

  function refreshStatus() {
    if (!statusTextEl) return;
    var labels = {
      idle: 'Idle',
      running: 'Running',
      paused: 'Paused',
      complete: 'Complete'
    };
    statusTextEl.textContent = labels[runnerState] || runnerState;
    var colors = {
      idle: '#fff',
      running: '#da7757',
      paused: '#ff9800',
      complete: '#4caf50'
    };
    statusTextEl.style.color = colors[runnerState] || '#fff';

    if (phaseCountEl) {
      var current = Math.min(currentPhaseIndex + 1, phases.length);
      if (phases.length === 0) current = 0;
      phaseCountEl.textContent = current + '/' + phases.length;
    }
  }

  function refreshPhaseList() {
    if (!phaseListEl) return;
    while (phaseListEl.firstChild) phaseListEl.removeChild(phaseListEl.firstChild);

    if (phases.length === 0) {
      var empty = document.createElement('li');
      empty.style.cssText = 'color:#666;font-size:11px;padding:8px 0;text-align:center;';
      empty.textContent = 'No phases loaded yet.';
      phaseListEl.appendChild(empty);
      return;
    }

    for (var i = 0; i < phases.length; i++) {
      (function (idx) {
        var phase = phases[idx];
        var li = document.createElement('li');
        li.className = 'pb-phase-item';

        var row = document.createElement('div');
        row.className = 'pb-phase-row';

        // Status icon
        var icon = document.createElement('span');
        icon.className = 'pb-phase-icon';
        if (phase.status === 'complete') {
          icon.className += ' pb-phase-icon-complete';
          icon.textContent = '\u2713';
        } else if (phase.status === 'running') {
          icon.className += ' pb-phase-icon-running';
          icon.textContent = '\u25B6';
        } else {
          icon.className += ' pb-phase-icon-pending';
          icon.textContent = String(phase.number);
        }

        // Label
        var label = document.createElement('span');
        label.className = 'pb-phase-label';
        var preview = phase.content.substring(0, 60).replace(/\n/g, ' ');
        if (phase.content.length > 60) preview += '...';
        label.textContent = 'Phase ' + phase.number + ': ' + preview;

        // Edit button
        var editBtn = document.createElement('button');
        editBtn.className = 'pb-phase-edit-btn';
        editBtn.textContent = '[edit]';
        editBtn.title = 'Edit this phase';

        // Set-as-current button (only if not running)
        var setCurBtn = document.createElement('button');
        setCurBtn.className = 'pb-phase-edit-btn';
        setCurBtn.textContent = '[start here]';
        setCurBtn.title = 'Set runner to start from this phase';
        if (runnerState === 'running') setCurBtn.style.display = 'none';

        row.appendChild(icon);
        row.appendChild(label);
        row.appendChild(editBtn);
        row.appendChild(setCurBtn);
        li.appendChild(row);

        // Expandable content area
        var contentDiv = document.createElement('div');
        contentDiv.className = 'pb-phase-content';
        var contentTextarea = document.createElement('textarea');
        contentTextarea.className = 'pb-textarea';
        contentTextarea.style.minHeight = '80px';
        contentTextarea.value = phase.content;
        var savePBtn = document.createElement('button');
        savePBtn.className = 'pb-btn';
        savePBtn.textContent = 'Save Edit';
        savePBtn.style.marginTop = '4px';
        contentDiv.appendChild(contentTextarea);
        contentDiv.appendChild(savePBtn);
        li.appendChild(contentDiv);

        // Toggle expand
        editBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          contentDiv.classList.toggle('pb-expanded');
        });

        // Save edit
        savePBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          phase.content = contentTextarea.value;
          saveState();
          refreshPhaseList();
          addLog('Phase ' + phase.number + ' updated.');
        });

        // Set as current
        setCurBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          if (runnerState === 'running') return;
          currentPhaseIndex = idx;
          for (var j = 0; j < phases.length; j++) {
            if (j < idx) phases[j].status = 'complete';
            else phases[j].status = 'pending';
          }
          saveState();
          refreshUI();
          addLog('Set start point to Phase ' + phase.number + '.');
        });

        phaseListEl.appendChild(li);
      })(i);
    }
  }

  function refreshControls() {
    if (!startBtn) return;
    var noPhases = phases.length === 0;
    startBtn.disabled = noPhases;
    pauseBtn.disabled = runnerState !== 'running';
    stopBtn.disabled = runnerState === 'idle' && currentPhaseIndex === 0;
    skipBtn.disabled = noPhases || currentPhaseIndex >= phases.length;

    if (runnerState === 'paused' || runnerState === 'complete') {
      startBtn.textContent = '\u25B6 Resume';
    } else {
      startBtn.textContent = '\u25B6 Start';
    }
    if (runnerState === 'complete') {
      startBtn.textContent = '\u21BB Restart';
    }
  }

  // ============================================================
  // INIT
  // ============================================================

  function waitForPage() {
    var check = setInterval(function () {
      if (document.body) {
        clearInterval(check);
        loadState();
        injectStyles();
        buildUI();
      }
    }, 200);
  }

  waitForPage();

})();
